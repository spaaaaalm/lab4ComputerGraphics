newmtl Material_0
Ka 1.000000 1.000000 1.000000
Ks 0.500000 0.500000 0.500000
Ke 0.000000 0.000000 0.000000
Ni 1.500000
d 1.000000
illum 2
# Слот t0: Цвет
map_Kd convertio.in_albedo.dds

# Слот t1: Карта нормалей (стандартный ключ для парсеров)
normals convertio.in_normal.dds
# или map_bump convertio.in_normal.dds

# Слот t2: Карта высот
disp convertio.in_displacement.dds